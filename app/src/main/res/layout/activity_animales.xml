<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:elevation="8dp">

                <!-- Encabezado -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestión de Animales"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulta y administración del ganado"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Filtro por lote -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FILTRAR POR LOTE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinnerLote"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/borde_celda"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp"/>

                <!-- Botones de acción -->
                <Button
                    android:id="@+id/btnAgregarAnimal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="+ AGREGAR NUEVO ANIMAL"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/green_primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btnGestionLotes"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ADMINISTRAR LOTES"
                    android:textColor="@color/white"
                    android:backgroundTint="#5D8A3C"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Tabla de animales -->
                <TableLayout
                    android:id="@+id/tableAnimales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="@color/white">

                    <TableRow
                        android:background="@color/green_primary"
                        android:padding="4dp">
                        <TextView
                            android:text="ARETE"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="12dp"/>
                        <TextView
                            android:text="TIPO"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="12dp"/>
                        <TextView
                            android:text="PESO"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="12dp"/>
                    </TableRow>
                </TableLayout>

                <!-- Botón Volver -->
                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="VOLVER"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:backgroundTint="#8E8E8E"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"
                    android:layout_marginTop="24dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>