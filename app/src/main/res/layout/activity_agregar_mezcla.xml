<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etNombreMezcla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la mezcla"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etCantidadTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cantidad total"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidad"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etFechaCreacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha de creación"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Estado"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Observaciones"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp"
            android:background="#FFFFFF"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnGuardarMezcla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Mezcla"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnVolverMezcla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"/>

    </LinearLayout>

</ScrollView>