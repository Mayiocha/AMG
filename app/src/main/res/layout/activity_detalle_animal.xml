<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fitsSystemWindows="true"> <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ficha del Animal"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/green_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/grayBackground"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID INTERNO:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NÚMERO DE ARETE (TAG):"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvArete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RAZA:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvRaza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CATEGORÍA:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvSexo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PESO REGISTRADO:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="20sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/green_primary"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EDAD (MESES):"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvMeses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOTE ACTUAL:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvLote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESTADO SANITARIO:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvEstadoSanitario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="18sp"
                android:textColor="@color/black"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnEditarAnimal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="EDITAR ANIMAL"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/green_primary"
            app:cornerRadius="8dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnVolverDetalle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VOLVER AL LISTADO"
            android:textStyle="bold"
            android:backgroundTint="#8E8E8E"
            app:cornerRadius="8dp"
            android:elevation="4dp"/>

    </LinearLayout>
</ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>