<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fitsSystemWindows="true"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloComidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comidas y Mezclas"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/green_primary"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de insumos y dietas"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnInventario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="INVENTARIO DE COMIDAS"
            android:textStyle="bold"
            android:backgroundTint="@color/green_primary"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnNuevaCarga"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GESTIÓN DE MEZCLAS"
            android:textStyle="bold"
            android:backgroundTint="@color/green_primary"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VOLVER"
            android:textStyle="bold"
            android:backgroundTint="#8E8E8E"
            android:textColor="@color/white"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>