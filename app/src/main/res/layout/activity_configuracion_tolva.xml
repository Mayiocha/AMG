<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F6B3A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:elevation="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configuración de Tolva"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1F6B3A"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Mezcla -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F4F7F4"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mezcla seleccionada"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#5F6B5F"/>

                <TextView
                    android:id="@+id/tvMezclaSeleccionada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mezcla Engorda 1"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"/>

                <Button
                    android:id="@+id/btnSeleccionarMezcla"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar mezcla"/>
            </LinearLayout>

            <!-- Hora -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F4F7F4"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora de dispensado"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#5F6B5F"/>

                <TextView
                    android:id="@+id/tvHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="08:00 AM"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"/>

                <Button
                    android:id="@+id/btnSeleccionarHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar hora"/>
            </LinearLayout>

            <!-- Cantidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F4F7F4"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad a dispensar"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#5F6B5F"/>

                <TextView
                    android:id="@+id/tvCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="25 kg"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"/>

                <Button
                    android:id="@+id/btnCantidadTolva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configurar cantidad"/>
            </LinearLayout>

            <!-- Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F4F7F4"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#5F6B5F"/>

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activo"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swTolvaActiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tolva activa"
                    android:checked="true"
                    android:textColor="#111111"
                    app:switchPadding="12dp"/>
            </LinearLayout>

            <!-- Resumen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#EAF4EC"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen actual"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F6B3A"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="La tolva está configurada con la mezcla seleccionada, una hora de dispensado y una cantidad definida."
                    android:textSize="14sp"
                    android:textColor="#333333"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnVolverConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Volver"
                android:textStyle="bold"
                android:padding="14dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>