<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:padding="24dp">

            <!-- Encabezado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configuración de Tolva"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Administra las rutinas de dispensado automático"
                android:textSize="13sp"
                android:textColor="#757575"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- Botones de acción -->
            <Button
                android:id="@+id/btnAgregarRutina"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="+ AGREGAR RUTINA"
                android:textColor="@color/white"
                android:backgroundTint="@color/green_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                android:elevation="2dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnHistorialTolva"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="VER HISTORIAL DE DISPENSADO"
                android:textColor="@color/white"
                android:backgroundTint="#5D8A3C"
                android:textStyle="bold"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp"/>

            <!-- Divisor encabezado de lista -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="RUTINAS PROGRAMADAS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvConteoRutinas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 rutinas"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <!-- Contenedor dinámico de rutinas -->
            <LinearLayout
                android:id="@+id/containerRutinas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Botón Volver -->
            <Button
                android:id="@+id/btnVolverConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="VOLVER"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="#8E8E8E"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:layout_marginTop="20dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>