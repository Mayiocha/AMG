<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo Lote"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/green_primary"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etLoteCapacidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Capacidad del lote (cantidad)"
        android:inputType="number"
        android:background="@drawable/borde_celda"
        android:padding="14dp"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Etapa de producción:"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spEtapa"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/borde_celda"
        android:spinnerMode="dropdown"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnConfirmarLote"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CREAR LOTE"
        android:textColor="@color/white"
        android:backgroundTint="@color/green_primary"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnCancelarLote"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CANCELAR"
        android:backgroundTint="#8E8E8E"
        android:textStyle="bold"
        app:cornerRadius="8dp"/>

</LinearLayout>
