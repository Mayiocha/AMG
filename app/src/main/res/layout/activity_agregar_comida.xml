<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fitsSystemWindows="true"> <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar Alimento"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registro para inventario de comidas"
                android:textSize="14sp"
                android:textColor="#757575"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etNombreComida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre del alimento"
                android:background="@drawable/borde_celda"
                android:padding="14dp"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etTipoComida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tipo (Silo, Grano, Balanceado...)"
                android:background="@drawable/borde_celda"
                android:padding="14dp"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <EditText
                    android:id="@+id/etCantidadComida"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Cantidad disponible"
                    android:inputType="numberDecimal"
                    android:background="@drawable/borde_celda"
                    android:padding="14dp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="8dp"/>
                <Spinner
                    android:id="@+id/spinnerUnidad"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:background="@drawable/borde_celda"
                    android:padding="10dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/etPrecioUnidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Precio por unidad"
                android:inputType="numberDecimal"
                android:background="@drawable/borde_celda"
                android:padding="14dp"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etStockMinimo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Stock mínimo"
                android:inputType="numberDecimal"
                android:background="@drawable/borde_celda"
                android:padding="14dp"
                android:textColor="@color/black"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnGuardarComida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GUARDAR ALIMENTO"
                android:textColor="@color/white"
                android:backgroundTint="@color/green_primary"
                android:textStyle="bold"
                android:padding="14dp"
                app:cornerRadius="8dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnVolverComida"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CANCELAR"
                android:textStyle="bold"
                android:backgroundTint="#8E8E8E"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:padding="14dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>