<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistema Ganadero AMG"
            android:textColor="#1F6B3A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel principal"
            android:textColor="#5F6B5F"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnIrAnimales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animales"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnIrComidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comidas y Mezclas"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnConfiguracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuración Tolva"
            android:textStyle="bold"
            android:padding="14dp"/>

    </LinearLayout>

</RelativeLayout>