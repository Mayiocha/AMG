<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/panelCentral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        android:padding="30dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistema Ganadero AMG"
            android:textColor="@color/green_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel de Control Profesional"
            android:textColor="#757575"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:letterSpacing="0.1"/>

        <Button
            android:id="@+id/btnIrAnimales"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GESTIÓN DE ANIMALES"
            android:textColor="@color/white"
            android:backgroundTint="@color/green_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:cornerRadius="8dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnIrComidas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="COMIDAS Y MEZCLAS"
            android:textColor="@color/white"
            android:backgroundTint="@color/green_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:cornerRadius="8dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnConfiguracion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONFIGURACIÓN TOLVA"
            android:textColor="@color/green_primary"
            android:backgroundTint="@color/white"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textStyle="bold"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="2dp"
            app:cornerRadius="8dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="MDGM Solutions © 2026"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:alpha="0.7"/>

</RelativeLayout>