<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <!-- Título dinámico -->
        <TextView android:id="@+id/tvDialogTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nueva Rutina" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/green_primary" android:gravity="center" android:layout_marginBottom="20dp"/>

        <!-- Nombre de la rutina -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOMBRE DE LA RUTINA" android:textSize="11sp" android:textStyle="bold" android:textColor="#888888" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>

        <EditText android:id="@+id/etRutinaNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. Rutina Mañana" android:background="@drawable/borde_celda" android:padding="14dp" android:textSize="15sp" android:textColor="@color/black" android:inputType="text" android:layout_marginBottom="16dp"/>

        <!-- Hora -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HORA DE DISPENSADO" android:textSize="11sp" android:textStyle="bold" android:textColor="#888888" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/borde_celda" android:padding="14dp" android:layout_marginBottom="16dp">

            <TextView android:id="@+id/tvHoraSeleccionada" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Seleccionar hora..." android:textSize="15sp" android:textColor="#999999"/>

            <Button android:id="@+id/btnElegirHora" android:layout_width="wrap_content" android:layout_height="36dp" android:text="ELEGIR" android:textSize="12sp" android:textColor="@color/white" android:backgroundTint="@color/green_primary" android:textStyle="bold" app:cornerRadius="4dp"/>
        </LinearLayout>

        <!-- Mezcla -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MEZCLA A DISPENSAR" android:textSize="11sp" android:textStyle="bold" android:textColor="#888888" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>

        <Spinner android:id="@+id/spRutinaMezcla" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/borde_celda" android:spinnerMode="dropdown" android:layout_marginBottom="16dp"/>

        <!-- Cantidad -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CANTIDAD A DISPENSAR (kg)" android:textSize="11sp" android:textStyle="bold" android:textColor="#888888" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>

        <EditText android:id="@+id/etRutinaCantidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. 25" android:background="@drawable/borde_celda" android:padding="14dp" android:textSize="15sp" android:textColor="@color/black" android:inputType="numberDecimal" android:layout_marginBottom="16dp"/>

        <!-- Checkbox activa -->
        <CheckBox android:id="@+id/cbRutinaActivaDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rutina activa" android:textSize="15sp" android:textColor="@color/black" android:checked="true" android:buttonTint="@color/green_primary" android:layout_marginBottom="20dp"/>

        <!-- Botones -->
        <Button android:id="@+id/btnGuardarRutina" android:layout_width="match_parent" android:layout_height="52dp" android:text="GUARDAR RUTINA" android:textColor="@color/white" android:backgroundTint="@color/green_primary" android:textStyle="bold" android:textSize="14sp" app:cornerRadius="8dp" android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/btnCancelarRutina" android:layout_width="match_parent" android:layout_height="52dp" android:text="CANCELAR" android:backgroundTint="#8E8E8E" android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp" app:cornerRadius="8dp"/>

    </LinearLayout>
</ScrollView>
